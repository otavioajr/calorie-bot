# Supabase client (points at self-hosted Postgres on VPS — not Supabase Cloud)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_BASE_URL=
# Required for POST webhook signature validation (Settings > Basic in Meta Developer Console)
META_APP_SECRET=

# LLM
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL_MEAL=openai/gpt-4o-mini
LLM_MODEL_CLASSIFY=meta-llama/llama-3.1-8b-instruct:free
LLM_MODEL_VISION=openai/gpt-4o

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_MEAL=llama3.1:8b
OLLAMA_MODEL_CLASSIFY=llama3.1:8b
OLLAMA_MODEL_VISION=llava:13b

# Fallback (optional)
LLM_FALLBACK_PROVIDER=

# Cron
CRON_SECRET=
# Fase 2 inbox (set true only after migration applied on VPS)
INBOUND_WORK_ENABLED=false
# Sweeper: VPS crontab curls /api/cron/inbox-sweeper every 2m — see docs/ops/vps-inbox-sweeper.md

# Fase 2b durable WhatsApp outbox (safe default)
OUTBOX_MODE=off              # off | shadow | active
OUTBOX_GENERATION=           # required in shadow/active; keep set after rollback for redaction
OUTBOX_CANARY_PHONES=        # comma-separated E.164 allowlist
OUTBOX_CANARY_PERCENT=0      # deterministic cohort from 0 to 100
# Bot shadow/active also requires INBOUND_WORK_ENABLED=true.
# VPS curls /api/cron/outbox-sweeper every minute — see docs/ops/vps-outbox-sweeper.md

# App URL (used for web panel links in bot messages)
NEXT_PUBLIC_APP_URL=https://caloriebot.app

# Audio (OpenAI Whisper — for voice message transcription)
OPENAI_API_KEY=

# Webhook Health Check
ADMIN_PHONE_NUMBER=           # WhatsApp number for admin alerts (e.g. 5511999999999)
META_APP_ID=                  # Meta app ID (from Developer Console)
